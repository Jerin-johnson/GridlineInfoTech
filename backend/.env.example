# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/gridline_ecommerce

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super_secret_access_jwt_key_with_at_least_32_characters
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_with_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cookies
COOKIE_SECRET=optional_cookie_secret_for_signed_cookies
