# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/gridline_ecommerce

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super_secret_access_jwt_key_with_at_least_32_characters
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_with_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cookies
COOKIE_SECRET=optional_cookie_secret_for_signed_cookies

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Crypto Payments (Sepolia Testnet)
CRYPTO_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CRYPTO_CHAIN_ID=11155111
CRYPTO_NETWORK=Sepolia
CRYPTO_TOKEN_SYMBOL=USDC
CRYPTO_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
CRYPTO_TOKEN_DECIMALS=6
CRYPTO_REQUIRED_CONFIRMATIONS=3
PAYMENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

